# Строка подключения к PostgreSQL
DATABASE_URL=postgresql+psycopg://dontloaf:dontloaf@db:5432/dontloaf

# Секрет для подписи JWT-токенов (сгенерируй свой: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: адрес фронтенда (Astro dev-сервер)
FRONTEND_ORIGIN=http://localhost:4321

# Google OAuth (вход через Google; оставь пустым, чтобы отключить)
# Redirect URI для Google Cloud Console:
#   {FRONTEND_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
