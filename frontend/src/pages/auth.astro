---
import Layout from '../layouts/Layout.astro';
import AuthPanel from '../components/AuthPanel';

const modeParam = Astro.url.searchParams.get('mode');
const initialMode = modeParam === 'login' ? 'login' : 'register';
---

<Layout title="DontLoaf — Вход и регистрация">
  <main class="auth-page" aria-label="Вход и регистрация">
    <AuthPanel client:load initialMode={initialMode} />
  </main>
</Layout>

